{
  "name": "dsh-cool-plugins",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugins by CoolTea: theme, terminal, git, file, session and daily.",
  "license": "MIT",
  "author": "CoolTea",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoolTea001/dsh-cool-plugins.git"
  },
  "homepage": "https://github.com/CoolTea001/dsh-cool-plugins#readme",
  "bugs": {
    "url": "https://github.com/CoolTea001/dsh-cool-plugins/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm run check:locales && pnpm -r --if-present run check && pnpm run check:client-bundles",
    "dev": "pnpm -r --parallel --if-present run dev",
    "icons": "pnpm --filter @dsh-cool/icons dev:catalog",
    "publish-all": "pnpm -r publish --access public",
    "check:locales": "node scripts/check-locales.mjs",
    "check:client-bundles": "node scripts/check-client-bundles.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
