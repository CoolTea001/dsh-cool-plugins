{
  "name": "@dsh-cool/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared React UI for the DSH plugins in this repository: the stylesheet owner, the one pointer gesture, the remembered layout, and the shell primitives re-exported with their real types.",
  "license": "MIT",
  "author": "CoolTea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoolTea001/dsh-cool-plugins.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck",
    "dev:catalog": "vite --config vite.config.ts",
    "build:catalog": "vite build --config vite.config.ts",
    "preview:catalog": "vite preview --config vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.3",
    "@dsh-cool/icons": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
