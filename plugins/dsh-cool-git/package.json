{
  "name": "dsh-cool-git",
  "version": "0.5.2",
  "description": "DeepSeek Harness Git plugin — adds a Git panel to the session tab bar: changes, commits, history, branches, remote sync, and merge-conflict resolution in one place, with AI-written commit messages.",
  "type": "module",
  "license": "MIT",
  "author": "CoolTea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoolTea001/dsh-cool-plugins.git",
    "directory": "plugins/dsh-cool-git"
  },
  "homepage": "https://github.com/CoolTea001/dsh-cool-plugins/tree/master/plugins/dsh-cool-git#readme",
  "bugs": {
    "url": "https://github.com/CoolTea001/dsh-cool-plugins/issues"
  },
  "keywords": [
    "dsh",
    "cordis",
    "plugin",
    "git",
    "deepseek-harness"
  ],
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "prepublishOnly": "pnpm run check",
    "dev": "tsdown --watch",
    "dev:types": "tsc -p tsconfig.json --watch --emitDeclarationOnly"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@dsh-cool/icons": "workspace:*",
    "@dsh-cool/tsdown-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
